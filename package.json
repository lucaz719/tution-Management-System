{
  "name": "tms-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:ui-login": "npm run build --workspace ui-login"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
