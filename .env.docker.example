# Copy this file to .env before sharing or deploying the stack.
POSTGRES_DB=tms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

API_PORT=3001
WEB_PORT=5173
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# Development-only provisioning surface. Keep false in production.
PLATFORM_ADMIN_ENABLED=false
SMS_PROVIDER=MOCK
NEPALPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

CONNECTIPS_ENABLED=false
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_PFX_BASE64=
CONNECTIPS_PFX_PASSWORD=
CONNECTIPS_VALIDATE_PASSWORD=
CONNECTIPS_GATEWAY_URL=https://uat.connectips.com/connectipswebgw/loginpage
CONNECTIPS_VALIDATE_URL=https://uat.connectips.com/connectipswebws/api/creditor/validatetxn
