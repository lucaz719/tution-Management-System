{
  "name": "@tms/api",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "sms:test": "npm run build && node dist/scripts/send-sms-test.js",
    "sms:fixture-test": "npm run build && node dist/scripts/run-sms-invoice-fixture.js",
    "sms:fixture-retry": "npm run build && node dist/scripts/retry-sms-invoice-fixture.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test:access": "ts-node src/utils/access-control.test.ts",
    "test:billing": "ts-node src/utils/billing-rules.test.ts",
    "test:connectips": "ts-node src/utils/connectips.test.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ],
    "ext": "ts,json,env"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@tms/types": "*",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.6.23",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "nepali-date-library": "^1.1.11",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.11",
    "@types/node-forge": "^1.3.14",
    "nodemon": "^2.0.22",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
